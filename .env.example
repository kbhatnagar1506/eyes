# Copy to .env (gitignored) and fill in. Bun loads it for `npm run up` / `npm run agents`.

# ---- iMessage (Photon Spectrum) ----------------------------------------------
# From app.photon.codes → your project. Every recipient must be added under
# Users and (on shared-pool plans) must text your Eyes line once first.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# 1 sends real iMessages; anything else is a dry run (messages print only).
EYES_SEND=0
# Responders' thread, police photos and EMS pages: numbers or Apple ID emails,
# comma-separated. Police and EMS default to the thread.
EYES_IMESSAGE_TO=
EYES_POLICE_TO=
EYES_EMS_TO=

# ---- Google Cloud ------------------------------------------------------------
# Gemini on Vertex AI words the agents' messages (auth: gcloud / ADC).
EYES_GCP_PROJECT=
EYES_MODEL=gemini-2.5-flash
# Private bucket for clips, evidence frames and model outputs.
EYES_MEDIA_BUCKET=
# Postgres for incidents, acknowledgements, agent messages, sign-ups (optional).
EYES_DATABASE_URL=

# ---- Mesh --------------------------------------------------------------------
EYES_HUB=ws://127.0.0.1:8787/mesh
EYES_HUB_PORT=8787
# The hosted app the tunnel's join links point at.
EYES_SITE=https://eyes-hacklanta.vercel.app
